# PayPal REST app credentials from https://developer.paypal.com (Apps & Credentials, Sandbox).
# Leave empty to run with the clearly labeled mock PayPal adapter.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Free OpenRouter key for the runtime models. Leave empty to use the deterministic fallbacks.
OPENROUTER_API_KEY=
# Optional comma separated model list (free models by default).
SETTLE_LLM_MODELS=
# Model calls per server instance per day (default 30).
SETTLE_LLM_CALLS_PER_DAY=
